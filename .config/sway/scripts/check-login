#!/bin/sh

log=/var/log/sddm.log

[ -r "$log" ] || {
    printf 'SWAY_LOGIN=UNKNOWN reason=sddm-log-unreadable\n'
    exit 2
}

result=$(awk '
  /Reading from / {
    if ($0 ~ /\/sway-managed\.desktop/) {
      seen = 1
      tracking = 1
      started = 0
      terminal = ""
    } else if (tracking) {
      tracking = 0
    }
  }
  tracking && /Session started true/ {
    started = 1
  }
  tracking && started && /Auth: sddm-helper exited/ {
    terminal = $0
  }
  END {
    if (!seen) {
      print "UNKNOWN"
    } else if (started && terminal == "") {
      print "ACTIVE"
    } else if (terminal ~ /exited successfully/) {
      print "CLEAN_EXIT"
    } else {
      print "FAILED " terminal
    }
  }
' "$log")

case "$result" in
  ACTIVE)
    printf 'SWAY_LOGIN=PASS state=active\n'
    exit 0
    ;;
  CLEAN_EXIT)
    printf 'SWAY_LOGIN=PASS state=clean-exit\n'
    exit 0
    ;;
  FAILED*)
    code=$(printf '%s\n' "$result" | sed -n 's/.*exited with \([0-9][0-9]*\).*/\1/p')
    printf 'SWAY_LOGIN=FAIL exit_code=%s\n' "${code:-unknown}"
    exit 1
    ;;
  *)
    printf 'SWAY_LOGIN=UNKNOWN reason=no-attempt\n'
    exit 2
    ;;
esac
