#!/bin/bash

set -uo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}/sway-session-services"
kanshi_pid_file="$runtime_dir/kanshi.pid"
kanshi_pid=''
kanshi_paused=false

resume_kanshi() {
    if [ "$kanshi_paused" = true ] && kill -0 "$kanshi_pid" 2>/dev/null; then
        kill -CONT "$kanshi_pid" 2>/dev/null || true
    fi
}
trap resume_kanshi EXIT HUP INT TERM

if [ -r "$kanshi_pid_file" ]; then
    kanshi_pid=$(sed -n '1p' "$kanshi_pid_file")
    case "$kanshi_pid" in
        ''|*[!0-9]*) kanshi_pid='' ;;
    esac
fi

if [ -n "$kanshi_pid" ] && kill -0 "$kanshi_pid" 2>/dev/null; then
    kill -STOP "$kanshi_pid"
    kanshi_paused=true
fi

wdisplays
wdisplays_rc=$?

if [ "$wdisplays_rc" -eq 0 ]; then
    profile_name=$(/home/eugene/.config/sway/scripts/kanshi-save-current)
else
    profile_name=''
fi

resume_kanshi
kanshi_paused=false
trap - EXIT HUP INT TERM

if [ -n "$kanshi_pid" ] && kill -0 "$kanshi_pid" 2>/dev/null; then
    kanshictl reload >/dev/null 2>&1 || true
fi

if [ -n "$profile_name" ] && command -v notify-send >/dev/null 2>&1; then
    notify-send \
        --app-name='Displays' \
        --icon=preferences-desktop-display \
        "Display profile saved" \
        "$profile_name will be restored automatically."
fi

exit "$wdisplays_rc"
