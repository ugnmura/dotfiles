# Eugene's Sway desktop
# Generated for this machine: Void Linux, AMD-driven dual displays, NVIDIA dGPU.

include /etc/sway/config.d/*

set $mod Mod4
set $term alacritty
set $menu /home/eugene/.config/sway/scripts/app-launcher
set $lock /home/eugene/.config/sway/scripts/lock
set $power /home/eugene/.config/sway/scripts/power-menu
set $clipboard /home/eugene/.config/sway/scripts/clipboard-menu
set $screenshot /home/eugene/.config/sway/scripts/screenshot
set $workspace_cycle /home/eugene/.config/sway/scripts/workspace-cycle

set $left Left
set $down Down
set $up Up
set $right Right

### Displays
# Kanshi owns output modes and positions so hotplugging is automatic.
output * bg /home/eugene/.wallpaper/wallpaper.png fill

# Stable workspace homes for the two displays.
workspace 1 output eDP-1
workspace 5 output HDMI-A-1

### Input
input type:keyboard {
    xkb_layout us
    xkb_numlock enabled
    repeat_delay 250
    repeat_rate 35
}

input type:touchpad {
    tap enabled
    dwt enabled
    natural_scroll enabled
    scroll_method two_finger
    click_method clickfinger
    middle_emulation enabled
}

input type:pointer {
    pointer_accel 0
}

seat * xcursor_theme Dracula-cursors 24
seat * hide_cursor 5000
seat * hide_cursor when-typing enable

focus_follows_mouse yes
focus_on_window_activation smart
mouse_warping output
workspace_auto_back_and_forth yes

### Appearance
font pango:Noto Sans 10
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
smart_borders off
smart_gaps off
gaps inner 12
gaps outer 18

### SwayFX polish
# Effects are intentionally moderate so the desktop stays fast and readable.
corner_radius 14
smart_corner_radius disable
shadows enable
shadows_on_csd enable
shadow_blur_radius 34
shadow_color #080811b8
shadow_inactive_color #08081170
shadow_offset 0 6

blur enable
blur_xray disable
blur_passes 2
blur_radius 4
blur_noise 0.02
blur_brightness 0.90
blur_contrast 0.95
blur_saturation 1.10

default_dim_inactive 0.06
dim_inactive_colors.unfocused #11111b20
dim_inactive_colors.urgent #f38ba820
titlebar_separator disable

layer_effects "waybar" {
    blur enable
    blur_xray enable
    blur_ignore_transparent enable
    shadows disable
    corner_radius 14
}

layer_effects "launcher" {
    blur enable
    blur_xray enable
    blur_ignore_transparent enable
    shadows enable
    corner_radius 14
}

layer_effects "swaync-control-center" {
    blur disable
    blur_xray disable
    blur_ignore_transparent enable
    shadows disable
    corner_radius 16
}

layer_effects "swaync-notification-window" {
    blur disable
    blur_xray disable
    blur_ignore_transparent enable
    shadows disable
    corner_radius 16
}

layer_effects "swayosd" {
    blur enable
    blur_xray enable
    blur_ignore_transparent enable
    shadows enable
    corner_radius 16
}

layer_effects "wlogout" {
    blur enable
    blur_xray enable
    blur_ignore_transparent enable
    shadows disable
    corner_radius 0
}

# border, background, text, indicator, child border
client.focused          #cba6f7 #181825 #e8e8f2 #cba6f7 #cba6f7
client.focused_inactive #45475a #181825 #a6adc8 #45475a #45475a
client.unfocused        #34354d #181825 #7f849c #34354d #34354d
client.urgent           #f38ba8 #181825 #e8e8f2 #f38ba8 #f38ba8
client.placeholder      #34354d #181825 #7f849c #34354d #34354d
client.background       #181825

### Session services
# The supervisor stops every child service when Sway exits.
exec /home/eugene/.config/sway/scripts/session-services

### Window rules
for_window [app_id="pavucontrol"] floating enable, resize set width 900 height 600, move position center
for_window [app_id="blueman-manager"] floating enable, resize set width 900 height 600, move position center
for_window [app_id="org.gnome.Nautilus"] floating enable, resize set width 1100 height 700, move position center
for_window [app_id="mpv"] floating enable
for_window [app_id="quick-terminal"] floating enable, resize set width 1100 height 680, move position center, move scratchpad
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_type="dialog"] floating enable

### Core controls
bindsym $mod+n exec $term
bindsym $mod+Return exec $term
bindsym $mod+p exec $menu
bindsym $mod+d exec swaync-client -t -sw
bindsym $mod+q kill
bindsym $mod+space floating toggle
bindsym $mod+m fullscreen
bindsym $mod+f fullscreen
floating_modifier $mod normal

bindsym $mod+Shift+c reload
bindsym $mod+Shift+d exec /home/eugene/.config/sway/scripts/display-settings
bindsym $mod+Shift+q exec swaynag -t warning -m 'Log out of Sway?' -B 'Log out' 'swaymsg exit'
bindsym $mod+Escape exec $power
bindsym $mod+Ctrl+l exec $lock
bindsym $mod+b exec /home/eugene/.config/sway/scripts/toggle-top-bar
bindsym $mod+grave exec /home/eugene/.config/sway/scripts/quick-terminal

### Focus and movement
# Preserve the old Hyprland J/K cycle while keeping familiar directional keys.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+Shift+comma move workspace to output left
bindsym $mod+Shift+period move workspace to output right

### Workspaces
bindsym $mod+o exec $workspace_cycle next
bindsym $mod+i exec $workspace_cycle prev
bindsym $mod+Ctrl+o exec $workspace_cycle move-next
bindsym $mod+Ctrl+i exec $workspace_cycle move-prev
bindsym $mod+Tab exec swayr switch-to-urgent-or-lru-window
bindsym $mod+Shift+Tab workspace back_and_forth

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

### Layout
bindsym $mod+Shift+v splitv
bindsym $mod+Shift+t layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+a focus parent

bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Launcher, clipboard, and screenshots
bindsym $mod+v exec $clipboard
bindsym $mod+w exec swayr switch-window
bindsym $mod+Shift+w exec swayr switch-workspace-or-window
bindsym $mod+Ctrl+w exec swayr steal-window
bindsym $mod+Shift+slash exec /home/eugene/.config/sway/scripts/keybindings
bindsym Print exec $screenshot output
bindsym $mod+Shift+s exec $screenshot region
bindsym $mod+Ctrl+s exec $screenshot window

### Hardware controls with on-screen feedback
bindsym --locked XF86AudioRaiseVolume exec /home/eugene/.config/sway/scripts/osd volume-up
bindsym --locked XF86AudioLowerVolume exec /home/eugene/.config/sway/scripts/osd volume-down
bindsym --locked XF86AudioMute exec /home/eugene/.config/sway/scripts/osd volume-mute
bindsym --locked XF86AudioMicMute exec /home/eugene/.config/sway/scripts/osd mic-mute
bindsym --locked XF86MonBrightnessUp exec /home/eugene/.config/sway/scripts/osd brightness-up
bindsym --locked XF86MonBrightnessDown exec /home/eugene/.config/sway/scripts/osd brightness-down
bindsym --locked XF86AudioPlay exec /home/eugene/.config/sway/scripts/osd play-pause
bindsym --locked XF86AudioPrev exec /home/eugene/.config/sway/scripts/osd previous
bindsym --locked XF86AudioNext exec /home/eugene/.config/sway/scripts/osd next
bindsym --locked XF86PowerOff exec $power
