{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-astra",
  "default_agent": "build",
  "agents": {
    "build": {
      "model": "openai/gpt-6-astra",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" }
      ]
    },
    "title": {
      "model": "rwth/Qwen 3.8 27B"
    },
    "explore": {
      "model": "rwth/Qwen 3.8 27B",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "easy": {
      "description": "Use for easy, bounded tasks: typo fixes, small mechanical edits, formatting, simple documentation, and straightforward implementation with clear acceptance criteria. Uses KI:connect Qwen, not paid OpenAI quota.",
      "mode": "all",
      "model": "rwth/Qwen 3.8 27B",
      "system": "Complete the assigned small task directly. Inspect only relevant files, preserve unrelated changes, and run the smallest useful check. Do not delegate or ask the user for permission. Keep the final report concise: changes, verification, and any blocker. If an operation is denied, or the task needs external-directory access, secrets, architectural decisions, security-sensitive changes, broad refactoring, or uncertain debugging, stop that part and return the exact operation and reason to the parent Astra controller for escalation rather than guessing or expanding scope.",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "researcher": {
      "description": "Read-only documentation lookup, source comparison, and bulk reading. Returns concise evidence and links using free KI:connect Qwen.",
      "mode": "subagent",
      "model": "rwth/Qwen 3.8 27B",
      "system": "Find the requested facts using targeted reads and searches. Return concise findings with exact file paths or source URLs. Do not edit files, expand the task, delegate, or ask the user for permission. If an operation is denied or needs external-directory or secret access, return the exact operation and reason to the parent Astra controller for escalation. State uncertainty instead of inventing facts.",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "summary": {
      "model": "rwth/Qwen 3.8 27B"
    }
  },
  "commands": {
    "easy": {
      "description": "Run a small task directly on KI:connect Qwen without an OpenAI controller turn",
      "agent": "easy",
      "model": "rwth/Qwen 3.8 27B",
      "subagent": false,
      "template": "$ARGUMENTS"
    }
  },
  "share": "disabled",
  "compaction": {
    "auto": true,
    "keep": { "tokens": 8000 },
    "buffer": 10000
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16000
  },
  "provider": {
    "rwth": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "RWTH / KI:connect",
      "options": {
        "baseURL": "https://chat.kiconnect.nrw/api/v1"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5"
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini"
        },
        "Qwen 3.8 27B": {
          "name": "Qwen 3.8 27B",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "gpt-oss-120b": {
          "name": "GPT OSS 120B",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "mistralai-mistral-small-4-119b": {
          "name": "Mistral Small 4 119B",
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
